{
  "name": "coco-flow",
  "version": "0.1.0",
  "description": "CoCo Flow — web app for CoCo canonical data models, sample XML generators, and XSLT transforms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proto": "vite --mode fixtures",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "serve": "tsx server/index.ts",
    "api": "powershell -ExecutionPolicy Bypass -File start-api.ps1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/xml": "^1.0.6",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "framer-motion": "^12.42.2",
    "http-proxy-middleware": "^3.0.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
